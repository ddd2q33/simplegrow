DATABASE_URL=sqlite:///./simplegrow.db
OPENAI_API_KEY=
YOUTUBE_API_KEY=
TIKTOK_API_KEY=
META_API_KEY=

# Zernio unified API. Server-side only: this bearer key can read and post to
# every connected account and must never reach the browser bundle. Never prefix
# it with NEXT_PUBLIC_.
# Docs: https://zernio.com/docs  |  API base: https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Where Zernio sends the browser after an OAuth connect finishes. Must be a
# frontend URL the browser can reach; Zernio appends connected, profileId,
# accountId and username.
ZERNIO_REDIRECT_URL=http://localhost:3000/dashboard/settings

# Zernio profiles group connected accounts. Every connect call needs one, so
# the backend resolves (or creates) this profile on first use.
ZERNIO_DEFAULT_PROFILE_NAME=SimpleGrow

# Zernio meters requests, not credits. The sync worker slows itself down to stay
# under the per-minute window instead of collecting 429s.
ZERNIO_REQUESTS_PER_MINUTE=60
ZERNIO_MIN_REMAINING_REQUESTS=8
ZERNIO_REQUEST_DELAY_SECONDS=1.1

# Daily snapshot scheduler. Leave it enabled so the local copy stays current;
# it disables itself automatically while ZERNIO_API_KEY is empty.
ZERNIO_SYNC_INTERVAL_HOURS=24
ZERNIO_SYNC_ON_STARTUP=false

# History pulled per account per run. Zernio keeps ~180 days, so the first run
# backfills the whole dashboard range at once.
ZERNIO_HISTORY_DAYS=90
ZERNIO_MAX_POSTS_PER_ACCOUNT=60
